{
  "name": "ai-website-clone-template",
  "version": "0.3.1",
  "private": true,
  "description": "LANHUI public brand site and admin CMS for automotive light modification and car film services",
  "author": "lanhui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run verify:zeekr-images && npm run check:backup && npm run check:breadcrumbs && npm run check:product-layout && npm run check:contact-copy && npm run check:product-placeholders && npm run check:product-image-copy && npm run check:footer-year && npm run check:admin-csrf && npm run check:region-duplication && npm run check:admin-page-duplication && npm run check:product-page-tests && npm run build",
    "verify:zeekr-images": "node scripts/verify-zeekr-images.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshot:all": "node scripts/audit/screenshot-all.mjs",
    "lighthouse:run": "node scripts/audit/lighthouse-run.mjs",
    "audit:full": "npm run screenshot:all && npm run lighthouse:run && playwright test e2e/audit-full-site.spec.ts",
    "db:backup": "node scripts/db-backup.mjs",
    "db:backup:dry-run": "node scripts/db-backup.mjs --dry-run",
    "db:restore": "node scripts/db-restore.mjs",
    "check:backup": "node scripts/check-backup-strategy.mjs",
    "check:breadcrumbs": "node scripts/check-product-breadcrumbs.mjs",
    "check:product-layout": "node scripts/check-product-layout.mjs",
    "check:contact-copy": "node scripts/check-production-contact-copy.mjs",
    "check:product-placeholders": "node scripts/check-product-placeholders.mjs",
    "check:product-image-copy": "node scripts/check-product-image-copy.mjs",
    "check:footer-year": "node scripts/check-footer-copyright-year.mjs",
    "check:admin-csrf": "node scripts/check-admin-csrf-fetch.mjs",
    "check:region-duplication": "node scripts/check-region-duplication.mjs",
    "check:product-page-tests": "node scripts/check-product-page-tests.mjs",
    "check:admin-page-duplication": "node scripts/check-admin-page-duplication.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@base-ui/react": "^1.3.0",
    "@fission-ai/openspec": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@rpamis/comet": "^0.4.0-beta.3",
    "@sentry/nextjs": "^10.63.0",
    "@tanstack/react-table": "^8.21.3",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pinyin-pro": "^3.28.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.78.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.1.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "@vitest/ui": "^3.2.0",
    "chrome-launcher": "^1.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "happy-dom": "^15.11.0",
    "lighthouse": "^13.4.0",
    "msw": "^2.14.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^3.2.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
